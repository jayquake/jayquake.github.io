		"editor.tokenColorCustomizations": {
			"textMateRules": [
				{
					"scope": "comment",
					"settings": {
						"foreground": "#4a6a6a",
						"fontStyle": "italic"
					}
				},
				{
					"scope": [
						"keyword",
						"storage.type",
						"storage.modifier"
					],
					"settings": {
						"foreground": "#a0a0a0",
						"fontStyle": "bold"
					}
				},
				{
					"scope": [
						"string",
						"string.quoted"
					],
					"settings": {
						"foreground": "#00bbaa"
					}
				},
				{
					"scope": [
						"constant.numeric",
						"constant.language"
					],
					"settings": {
						"foreground": "#00ffcc"
					}
				},
				{
					"scope": [
						"entity.name.function",
						"support.function"
					],
					"settings": {
						"foreground": "#b0b0b0"
					}
				},
				{
					"scope": [
						"entity.name.class",
						"entity.name.type"
					],
					"settings": {
						"foreground": "#c0c0c0"
