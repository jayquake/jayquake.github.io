# AccessFlow SDK — GCP Artifact Registry (package install)
# Staging: us-east1-npm.pkg.dev/accessflow-rm5h5j8lmu/stag-accessflow-npm
# Production (client delivery): us-east1-npm.pkg.dev/accessflow-2c09/prod-accessflow-npm
GCP_SDK_NPM_REGISTRY_URL=us-east1-npm.pkg.dev/accessflow-2c09/prod-accessflow-npm
ACCESSFLOW_NPM_REGISTRY_TOKEN=

# AccessFlow SDK — runtime Audit SDK API key (accessFlow → Profile → Token management)
# Do not use the NPM install token here. Do not prefix with "export".
# SDK also reads ACCESSFLOW_SDK_API_KEY (same value as AF_NODE_PACKAGE_KEY is OK).
AF_NODE_PACKAGE_KEY=
ACCESSFLOW_SDK_API_KEY=

# Selenium global-setup (Playwright uses localhost:3003 from playwright.config.js)
BASE_URL=http://localhost:3003
