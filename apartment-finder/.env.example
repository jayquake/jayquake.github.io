# ---- Core ----
PORT=8080
DATABASE_URL="file:./data/apartments.db"
# Shown in alert messages as the "see all results" link.
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# ---- Schedule ----
# Default: 07:30 every morning, Israel time.
SCAN_CRON=30 7 * * *
TZ_NAME=Asia/Jerusalem
# Run a scan immediately on boot. Handy the first time, noisy afterwards.
SCAN_ON_STARTUP=false

# ---- Sources ----
SOURCES=yad2,homeless
MAX_PAGES_PER_SOURCE=3
# Delay between page loads, in ms. Do not lower this — it is what keeps the
# scraping polite and keeps you off the bot-detection radar.
SCRAPE_THROTTLE_MS=4000
NAV_TIMEOUT_MS=60000
HEADLESS=true
# Leave unset to use Playwright's bundled Chromium. The Docker image sets it.
# CHROMIUM_PATH=/usr/bin/chromium
BROWSER_PROFILE_DIR=./data/browser-profile
# Optional outbound proxy, e.g. http://user:pass@host:port
# SCRAPE_PROXY=

# Listings not seen for this many days are marked inactive.
STALE_AFTER_DAYS=14

# ---- Notifications ----
# Comma-separated: whatsapp, telegram, console
NOTIFY_CHANNELS=console

# --- WhatsApp via Twilio ---
# Sandbox quick start: https://console.twilio.com/us1/develop/sms/try-it-out/whatsapp-learn
# Send the join code to +1 415 523 8886 from your phone, then fill these in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+9725XXXXXXXX
# Only needed for messages sent outside the 24h service window (see README).
# TWILIO_CONTENT_SID=

# --- Telegram (free alternative) ---
# Create a bot with @BotFather, then get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
